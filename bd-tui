def menu_hint(current: str, target: str, open_kids: int) -> str:
    """What picking a status in the menu does to a bead in its current status, in a few words."""
    if target == current:
        return "current"
    if target == "closed":
        return (f"bd closes it only after its {open_kids} open child beads" if open_kids
                else "asks for the result, which counts as reviewed")
    if target == "deferred":
        return "asks for a date and what brings it back"
    first = {"closed": "reopens it", "deferred": "undefers it"}.get(current)
    if target == "in_progress":
        return f"{first} and claims it" if first else "claims it, so the board shows it working"
    if current == "closed":
        return "reopens it, and its next result waits for review"
    return first or "releases the claim"


def short(bead_id: str, epic: str | None) -> str:
    """A bead's id without its epic's prefix, such as .14 for ent-aaa.14 under ent-aaa."""
    return bead_id[len(epic):] if epic and bead_id.startswith(epic + ".") else bead_id


def note_body(note: dict) -> str:
    return re.sub(r"^[:\s*]+", "", bm.DATE_RE.sub("", note["text"], count=1))


def local_date(stamp: str | None) -> str:
    """A bd timestamp, which is UTC, as the local date, so that a bead deferred to 2026-12-01 reads 2026-12-01."""
    if not stamp:
        return ""
    try:
        return datetime.fromisoformat(stamp).astimezone().strftime("%Y-%m-%d")
    except ValueError:
        return stamp[:10]


def split_cells(counts: list[int], width: int = 10) -> list[int]:
    """Width cells split over counts in proportion, where every count above zero gets at least one cell.

    So a bar whose last P0 bead is still open never rounds up to full, and one bead in progress never rounds to nothing.
    """
    total = sum(counts)
    if not total:
        return [0] * len(counts)
    cells = [max(1, round(width * c / total)) if c else 0 for c in counts]
    while sum(cells) > width:
        cells[cells.index(max(cells))] -= 1
    while sum(cells) < width:
        short_by = [width * c / total - n for c, n in zip(counts, cells)]
        cells[short_by.index(max(short_by))] += 1
    return cells


def fit(text: str, width: int) -> str:
    """Text cut to a column width with an ellipsis, then padded to it."""
    return (text if len(text) <= width else text[:max(0, width - 1)] + "…").ljust(width)


def clip(text: str) -> tuple[str, int]:
    """The first NOTE_LINES lines or NOTE_CHARS characters of a note, and how many lines were left out.

    The line that crosses the character budget is cut at a word, so a long first paragraph still shows.
    """
    lines = text.strip().split("\n")
    kept, size = [], 0
    for line in lines:
        if len(kept) == NOTE_LINES or size >= NOTE_CHARS:
            break
        room = NOTE_CHARS - size
        if len(line) > room:
            kept.append(line[:room].rsplit(" ", 1)[0] + " …")
            size = NOTE_CHARS
            continue
        kept.append(line)
        size += len(line)
    return "\n".join(kept), len(lines) - len(kept)


def markdown_lite(text: str) -> Text:
    """A note's Markdown as terminal text: headings and **bold** in bold, `code` in the id colour, bullets as •."""
    out = Text()
    body, more = clip(text)
    for line in body.split("\n"):
        heading = re.match(r"^#{1,6}\s+(.*)$", line)
        if heading:
            out.append(heading.group(1) + "\n", style="bold")
            continue
        line = re.sub(r"^(\s*)[-*]\s+", r"\1• ", line)
        for part in re.split(r"(\*\*[^*\n]+\*\*|`[^`\n]+`)", line):
            if part.startswith("**") and part.endswith("**") and len(part) > 4:
                out.append(part[2:-2], style="bold")
            elif part.startswith("`") and part.endswith("`") and len(part) > 2:
                out.append(part[1:-1], style=ID)
            else:
                out.append(part)
        out.append("\n")
    if more:
        out.append(f"{more} more lines; Enter opens the whole bead\n", style=MUTED)
    return out


def wrap_keys(groups: list[list[tuple[str, str, bool]]], width: int) -> list[Text]:
    """(key, words, on) triples as lines no wider than width, with · between keys, │ between groups and on in reverse."""
    lines, line, used = [], Text(), 0
    for g, group in enumerate(groups):
        for k, (key, words, on) in enumerate(group):
            sep = " │ " if g and not k else " · "
            size = len(key) + 1 + len(words) + (len(sep) if used else 0)
            if used and used + size > width:
                lines.append(line)
                line, used, size = Text(), 0, size - len(sep)
            if used:
                line.append(sep, style=MUTED)
            line.append(key, style="bold " + ID)
            line.append(" " + words, style="reverse" if on else MUTED)
            used += size
    lines.append(line)
    return lines


def grid() -> Table:
    """Two columns, so a wrapped value keeps a hanging indent under its label."""
    table = Table.grid(padding=(0, 1))
    table.add_column(no_wrap=True)
    table.add_column(ratio=1)
    return table


def joined(parts: list[tuple[str, str]], sep: str = " · ") -> Text:
    """Text from (words, style) pairs with muted separators."""
    out = Text()
    for i, (words, style) in enumerate(parts):
        if i:
            out.append(sep, style=MUTED)
        out.append(words, style=style)
    return out


class LineInput(Input, inherit_bindings=False):
    """Input without Ctrl-k, which vim-tmux-navigator takes for moving between panes."""

    BINDINGS = [b for b in Input.BINDINGS if not BANNED & set(b.key.split(","))]


class BeadTree(Tree, inherit_bindings=False):
    """The thread tree, moved with h j k l, Ctrl-n and Ctrl-p as well as the arrows."""

    BINDINGS = [
        Binding("j,down,ctrl+n", "cursor_down", show=False),
        Binding("k,up,ctrl+p", "cursor_up", show=False),
        Binding("h,left", "fold", show=False),
        Binding("l,right", "unfold", show=False),
        Binding("space", "toggle_node", show=False),
        Binding("pageup", "page_up", show=False),
        Binding("pagedown", "page_down", show=False),
        Binding("home", "scroll_home", show=False),
        Binding("end", "scroll_end", show=False),
        Binding("enter", "app.open_bead", show=False),
    ]

    def action_fold(self) -> None:
        node = self.cursor_node
        if node is None:
            return
        if node.is_expanded and node.children:
            node.collapse()
        elif node.parent is not None and node.parent is not self.root:
            self.move_cursor(node.parent)

    def action_unfold(self) -> None:
        node = self.cursor_node
        if node is None or not node.children:
            return
        if not node.is_expanded:
            node.expand()
        else:
            self.move_cursor(node.children[0])


class AskScreen(ModalScreen[str | None]):
    """One line of text for the session that `s` starts."""

    DEFAULT_CSS = """
    AskScreen { align: center middle; }
    AskScreen > Vertical { width: 90%; max-width: 100; height: auto; border: round $accent; padding: 0 1; background: $panel; }
    """
    BINDINGS = [Binding("escape", "cancel", show=False)]

    def __init__(self, bead_id: str, keywords: list[str]) -> None:
        super().__init__()
        self.bead_id, self.keywords = bead_id, keywords

    def compose(self) -> ComposeResult:
        mode = f" It starts with {', '.join(self.keywords)} (mode label)." if self.keywords else ""
        with Vertical():
            yield Static(f"Start a Claude session on {self.bead_id}. Claude reads the bead, then follows your text.{mode}\n"
                         "Enter starts it, Esc cancels.")
            yield LineInput(placeholder=f"What should Claude do with {self.bead_id}?", id="ask")

    def on_mount(self) -> None:
        self.query_one("#ask", LineInput).focus()

    def on_input_submitted(self, event: Input.Submitted) -> None:
        event.stop()
        self.dismiss(event.value)

    def action_cancel(self) -> None:
        self.dismiss(None)


class MenuList(OptionList):
    """The status menu's list, moved with j and k as well as the arrows, like the tree."""

    BINDINGS = [Binding("j", "cursor_down", show=False), Binding("k", "cursor_up", show=False)]


class StatusScreen(ModalScreen[str | None]):
    """The menu that Shift-S opens: the four statuses the board reads, with the bead's current status marked.

    A row's letter, or the arrows and Enter, picks a status. The current status is greyed out, and so is closed
    while the bead has open children, because bd closes a bead only after its children.
    """

    DEFAULT_CSS = """
    StatusScreen { align: center middle; }
    StatusScreen > Vertical { width: 90%; max-width: 80; height: auto; border: round $accent; padding: 0 1; background: $panel; }
    StatusScreen MenuList { height: auto; margin-top: 1; border: none; background: $panel; }
    StatusScreen .hint { margin-top: 1; color: $text-muted; }
    """
    BINDINGS = [Binding("escape", "cancel", show=False),
                *[Binding(key, f"pick('{status}')", show=False) for status, (key, _) in MENU.items()]]

    def __init__(self, bead_id: str, title: str, current: str, open_kids: int) -> None:
        super().__init__()
        self.bead_id, self.title_line, self.current, self.open_kids = bead_id, title, current, open_kids

    def compose(self) -> ComposeResult:
        rows = []
        for status in bm.STATUSES:
            key, name = MENU[status]
            off = status == self.current or (status == "closed" and self.open_kids > 0)
            hint = menu_hint(self.current, status, self.open_kids)
            line = f"{'●' if status == self.current else ' '} {key}  {name:<12} {hint}"
            # A greyed-out row stays unstyled, so that the list's disabled colour reaches every word of it.
            rows.append(Option(line if off else Text.assemble(line[:2], (key, "bold " + ID), f"  {name:<12} ",
                                                              (hint, MUTED)), id=status, disabled=off))
        with Vertical():
            yield Static(Text.assemble(("Status of ", "bold"), (self.bead_id, "bold " + ID), " · " + self.title_line))
            yield MenuList(*rows, id="status-menu")
            yield Static("A letter, or ↑↓ and Enter, picks a status. Esc cancels.", classes="hint")

    def on_mount(self) -> None:
        menu = self.query_one(MenuList)
        menu.highlighted = next((i for i, s in enumerate(bm.STATUSES) if not menu.get_option(s).disabled), None)
        menu.focus()

    def on_option_list_option_selected(self, event: OptionList.OptionSelected) -> None:
        event.stop()
        self.dismiss(event.option.id)

    def action_pick(self, status: str) -> None:
        if not self.query_one(MenuList).get_option(status).disabled:
            self.dismiss(status)

    def action_cancel(self) -> None:
        self.dismiss(None)


class ActScreen(ModalScreen[dict | None]):
    """The prompt that closed and deferred open from the status menu: what will happen, then one or two fields.

    Enter moves to the next field and acts from the last one. An empty required field keeps the prompt
    open with a note under it, so nothing typed is lost.
    """

    DEFAULT_CSS = """
    ActScreen { align: center middle; }
    ActScreen > Vertical { width: 90%; max-width: 100; height: auto; border: round $accent; padding: 0 1; background: $panel; }
    ActScreen .field { margin-top: 1; color: $text-muted; }
    ActScreen #act-error { color: $error; }
    """
    BINDINGS = [Binding("escape", "cancel", show=False)]

    def __init__(self, target: str, bead_id: str, title: str, values: dict) -> None:
        super().__init__()
        self.target, self.bead_id, self.title_line, self.values = target, bead_id, title, values
        self.word, self.lead, self.fields = FORMS[target]

    def compose(self) -> ComposeResult:
        last = "on the last field " if len(self.fields) > 1 else ""
        with Vertical():
            yield Static(Text.assemble((self.title_line, "bold"), "\n", self.lead.format(id=self.bead_id)))
            for name, label, placeholder, _ in self.fields:
                yield Static(label, classes="field")
                yield LineInput(value=self.values.get(name, ""), placeholder=placeholder, id=f"act-{name}")
            yield Static("", id="act-error")
            yield Static(f"Enter {last}{self.word} it, Esc cancels.", classes="field")

    def on_mount(self) -> None:
        self.query_one(f"#act-{self.fields[0][0]}", LineInput).focus()

    def on_input_submitted(self, event: Input.Submitted) -> None:
        event.stop()
        names = [name for name, _, _, _ in self.fields]
        at = names.index(event.input.id.removeprefix("act-"))
        if at + 1 < len(names):
            self.query_one(f"#act-{names[at + 1]}", LineInput).focus()
            return
        values = {name: self.query_one(f"#act-{name}", LineInput).value.strip() for name in names}
        missing = [(name, label) for name, label, _, required in self.fields if required and not values[name]]
        if missing:
            self.query_one("#act-error", Static).update(f"Type the {missing[0][1].lower()} first.")
            self.query_one(f"#act-{missing[0][0]}", LineInput).focus()
            return
        self.dismiss(values)

    def action_cancel(self) -> None:
        self.dismiss(None)


class BeadBoard(App):
    TITLE = "bd-tui"
    ENABLE_COMMAND_PALETTE = False
    CSS = """
    #title { height: 1; background: $boost; padding: 0 1; }
    #tree { height: 2fr; border-bottom: solid $primary-darken-2; }
    #detail { height: 3fr; padding: 0 1; }
    #search { dock: bottom; display: none; border: none; height: 1; padding: 0 1; }
    #search.on { display: block; }
    #keys { height: 2; background: $boost; padding: 0 1; }
    """
    BINDINGS = [
        Binding("o", "scope('open')", show=False),
        Binding("d", "scope('deferred')", show=False),
        Binding("c", "scope('closed')", show=False),
        Binding("n", "narrow('now')", show=False),
        Binding("v", "narrow('unreviewed')", show=False),
        Binding("p", "narrow('P0')", show=False),
        Binding("g", "thread", show=False),
        Binding("slash", "search", show=False),
        Binding("escape", "clear_search", show=False),
        Binding("r", "reload", show=False),
        Binding("m", "mark_reviewed", show=False),
        Binding("S", "status", show=False),
        Binding("s", "start_session", show=False),
        Binding("a", "attach", show=False),
        Binding("q", "quit", show=False),
    ]

    def __init__(self, load_rows: Callable[[], list[dict]] = bm.export_beads,
                 load_sessions: Callable[[], list[dict]] | None = lambda: bm.list_sessions(False),
                 set_reviewed: Callable[[str, bool], None] = bm.set_reviewed, refresh_s: float = REFRESH_S,
                 run_bd: Callable[[list[str]], None] = bm.bd_write) -> None:
        super().__init__()
        self.load_rows, self.load_sessions, self.set_reviewed = load_rows, load_sessions, set_reviewed
        self.refresh_s, self.run_bd = refresh_s, run_bd
        self.drafts: dict[tuple[str, str], dict] = {}  # (act, bead id) -> what Ben typed into a prompt whose bd call failed
        self.rows_key = ""  # the last export as JSON, so a reread that changes nothing skips the rebuild
        self.detail_for: tuple | None = None  # what the detail pane shows, so a rebuild keeps its scroll
        self.beads: dict[str, dict] = {}
        self.sessions: dict[str, str] = {}  # bead id -> the liveliest state of its sessions
        self.scope_name = "open"  # the list the tree shows: a key of SCOPES
        self.filters_on: dict[str, bool] = {name: False for name, _, _ in FILTERS}
        self.thread_view = False
        self.query_text = ""
        self.expanded: set[str] | None = None  # None until the first tree, which opens the first area
        self.open_busiest = False  # set by o, d and c, so a new list whose areas are all folded opens one
        self.title_text = Text("")  # the title and the key strip, kept for the headless test
        self.keys_text = Text("")
        self.read_at = 0.0
        self.error = ""
        self.detail: RenderableType = Text("")  # what the detail pane shows, kept for the headless test

    def compose(self) -> ComposeResult:
        yield Static(id="title")
        yield BeadTree("beads", id="tree")
        with VerticalScroll(id="detail"):
            yield Static(id="body")
        yield LineInput(placeholder="search ids and titles · Enter keeps it · Esc clears", id="search")
        yield Static(id="keys")

    def on_mount(self) -> None:
        tree = self.query_one(BeadTree)
        tree.show_root = False
        tree.guide_depth = 3
        tree.focus()
        self.render_keys()
        self.action_reload()
        if self.refresh_s:
            self.set_interval(self.refresh_s, self.timed_reload)
        if self.load_sessions:
            self.set_interval(SESSION_POLL_S, self.refresh_sessions)

    def on_resize(self) -> None:
        if self.beads:
            self.rebuild()
        else:
            self.render_keys()

    # ---------- data ----------

    def timed_reload(self) -> None:
        """The timer's reread, skipped while the last export still runs, so a slow bd never stacks exports."""
        if not any(w.group == "export" and w.is_running for w in self.workers):
            self.action_reload()

    @work(thread=True, exclusive=True, group="export")
    def action_reload(self) -> None:
        try:
            rows = self.load_rows()
        except (subprocess.SubprocessError, OSError, ValueError) as e:
            msg = (getattr(e, "stderr", "") or str(e)).strip()
            self.call_from_thread(self.set_error, f"bd export failed: {msg}")
            return
        self.call_from_thread(self.set_rows, rows)

    def set_rows(self, rows: list[dict]) -> None:
        self.read_at, self.error = time.time(), ""
        key = json.dumps(rows, sort_keys=True, default=str)
        if key == self.rows_key:
            self.render_title()
            return
        self.rows_key, self.beads = key, bm.enrich(rows)
        self.rebuild()
        self.refresh_sessions()

    def set_error(self, msg: str) -> None:
        self.error = msg
        self.render_title()

    @work(thread=True, exclusive=True, group="sessions")
    def refresh_sessions(self) -> None:
        if not self.load_sessions:
            return
        try:
            sessions = self.load_sessions()
        except (subprocess.SubprocessError, OSError, ValueError):
            return
        rank = {"working": 0, "blocked": 1, "done": 2}
        live: dict[str, str] = {}
        for s in sessions:
            bead_id = (s.get("name") or "").split(" ")[0]
            state = s.get("state") or "done"
            if bm.session_bead(s.get("name"), bead_id) and rank.get(state, 3) < rank.get(live.get(bead_id, ""), 4):
                live[bead_id] = state
        self.call_from_thread(self.set_sessions, live)

    def set_sessions(self, live: dict[str, str]) -> None:
        if live != self.sessions:
            self.sessions = live
            self.rebuild()

    # ---------- tree ----------

    def funnel(self, scope: str | None = None, filters: dict[str, bool] | None = None) -> list[tuple[str, list[str]]]:
        """The tree's list as steps: the scope's beads, then each filter that is on, then the search.

        Each step is (name, the bead ids left after it), so the title can show the count at every step.
        The arguments stand in for the current scope or filters, so the key strip can count what a key would leave.
        """
        scope = scope or self.scope_name
        on = self.filters_on if filters is None else filters
        ids = [i for i, b in self.beads.items() if b.get("issue_type") != "epic" and SCOPES[scope][2](b)]
        steps = [(SCOPES[scope][1], ids)]
        for name, _, keep in FILTERS:
            if on.get(name) and (name != "unreviewed" or scope == "closed"):
                ids = [i for i in ids if keep(self.beads[i])]
                steps.append((name, ids))
        q = self.query_text.lower()
        if q:
            ids = [i for i in ids if q in i.lower() or q in (self.beads[i].get("title") or "").lower()]
            steps.append((f"“{self.query_text}”", ids))
        return steps

    def shown(self) -> list[str]:
        """The beads the tree lists: what is left after the funnel's last step."""
        return self.funnel()[-1][1]

    def groups(self) -> list[tuple[str, list[tuple[str | None, list[str]]]]]:
        """The shown beads as [(area, [(epic id or None, [bead ids])])], busiest area and epic first."""
        tree: dict[str, dict[str | None, list[str]]] = {}
        for bid in self.shown():
            area = bm.area_of(self.beads, bid) or NO_AREA
            tree.setdefault(area, {}).setdefault(bm.epic_of(self.beads, bid), []).append(bid)
        heat = lambda ids: -sum(self.is_working(i) + self.needs_you(i) for i in ids)
        bead_key = lambda i: (not self.is_working(i), not self.needs_you(i), bm.RANK[self.beads[i]["bucket"]], bm.id_key(i))
        out = []
        for area, epics in tree.items():
            ordered = sorted(epics.items(), key=lambda e: (e[0] is None, heat(e[1]), bm.id_key(e[0] or "")))
            out.append((area, [(e, sorted(ids, key=bead_key)) for e, ids in ordered]))
        return sorted(out, key=lambda a: (a[0] == NO_AREA, heat([i for _, ids in a[1] for i in ids]), a[0]))

    def is_working(self, bid: str) -> bool:
        return self.beads[bid]["status"] == "in_progress"

    def needs_you(self, bid: str) -> bool:
        return bm.asks_ben_now(self.beads[bid])

    def counts(self, ids: list[str]) -> Text:
        """How many listed beads are in progress and need Ben, with the marks the bead rows use."""
        w = sum(1 for i in ids if self.is_working(i))
        y = sum(1 for i in ids if self.needs_you(i))
        out = Text()
        if w:
            out.append(f"  ◐{w}", style=STATUS_STYLE["prog"])
        if y:
            out.append(f"  ?{y}", style=NEEDS_STYLE)
        return out

    def area_label(self, area: str, ids: list[str]) -> Text:
        return Text.assemble((area, HEAD), self.counts(ids))

    def epic_label(self, epic: str | None, ids: list[str], width: int) -> Text:
        if epic is None:
            return Text("No epic") + self.counts(ids)
        e, p0 = self.beads[epic], self.p0_beads(epic)
        t = Text()
        t.append(epic, style=ID)
        t.append(" " + fit(e.get("title") or "", max(0, width - len(epic) - 1)) + " ")
        if not p0:
            t.append("no P0 beads", style=MUTED)
            return t + self.counts(ids)
        done = sum(1 for i in p0 if self.beads[i]["bucket"] == "closed")
        prog = sum(1 for i in p0 if self.beads[i]["bucket"] == "prog")
        for (glyph, style), cells in zip(BAR, split_cells([done, prog, len(p0) - done - prog])):
            t.append(glyph * cells, style=style)
        t.append(f" {done}/{len(p0)}", style=MUTED)
        return t + self.counts(ids)

    def p0_beads(self, epic: str) -> list[str]:
        """An epic's P0 beads, the ones its MVP needs, with any nested epic left out."""
        return [i for i in bm.descendants(self.beads, epic)
                if self.beads[i].get("issue_type") != "epic" and self.beads[i].get("priority") == 0]

    def bead_label(self, bid: str, epic: str | None, width: int) -> Text:
        b = self.beads[bid]
        state = self.sessions.get(bid)
        t = Text()
        t.append("●" if state else " ", style=SESSION_STYLE.get(state or "", MUTED))
        t.append(STATUS_MARK[b["bucket"]], style=STATUS_STYLE[b["bucket"]])
        asks = bm.asks_ben_now(b)
        t.append("?" if asks else "◇" if b["awaiting"] else " ", style=NEEDS_STYLE if asks else REVIEW_STYLE)
        t.append(" " + short(bid, epic).ljust(6) + " ", style=ID)
        t.append(fit(b.get("title") or "", width))
        p = b.get("priority")
        t.append(f" P{p}", style="" if p == 0 else MUTED)
        return t

    def rebuild(self) -> None:
        tree = self.query_one(BeadTree)
        keep = tree.cursor_node.data if tree.cursor_node else None
        # The bead rows Ben can see, in order, so that a bead that leaves the list hands the cursor to the bead after it.
        seen = [n.data[1] for n in self.walk(tree.root)
                if n.data and n.data[0] == "bead" and all(p.is_expanded for p in self.ancestors(n))]
        # The tree's guides, marks, id and priority take about 22 columns of a bead row and 32 of an epic row.
        pane = tree.size.width or self.size.width
        bead_w, epic_w = max(12, min(100, pane - 22)), max(12, min(90, pane - 32))
        groups = self.groups()
        # The first tree, and a list from o, d or c whose areas are all folded, open the busiest area and its epics.
        if groups and (self.expanded is None or (self.open_busiest and not any(f"a:{a}" in self.expanded for a, _ in groups))):
            area = groups[0][0]
            self.expanded = (self.expanded or set()) | {f"a:{area}"} | {f"e:{area}/{e}" for e, _ in groups[0][1]}
        self.open_busiest = False
        searching = bool(self.query_text)
        self.rebuilding = True
        tree.clear()
        target: TreeNode | None = None
        leaves: dict[str, TreeNode] = {}
        for area, epics in groups:
            all_ids = [i for _, ids in epics for i in ids]
            an = tree.root.add(self.area_label(area, all_ids), data=("area", area),
                               expand=searching or f"a:{area}" in (self.expanded or set()))
            for epic, ids in epics:
                en = an.add(self.epic_label(epic, ids, epic_w), data=("epic", epic, area),
                            expand=searching or f"e:{area}/{epic}" in (self.expanded or set()))
                if keep == en.data:
                    target = en
                for bid in ids:
                    leaves[bid] = en.add_leaf(self.bead_label(bid, epic, bead_w), data=("bead", bid))
            if keep and keep[0] == "area" and keep[1] == area:
                target = an
        if keep and keep[0] == "bead":
            target = leaves.get(keep[1])
            if target is None and keep[1] in seen:
                at = seen.index(keep[1])
                target = next((leaves[i] for i in seen[at + 1:] + seen[:at][::-1] if i in leaves), None)
        self.rebuilding = False
        self.render_title()
        self.render_keys()
        self.call_after_refresh(self.restore_cursor, target)

    def restore_cursor(self, target: TreeNode | None) -> None:
        tree = self.query_one(BeadTree)
        # A tree lays out its rows only when it is idle, and a tree behind an open prompt never is, so a rebuilt node
        # would report line -1 and the cursor would land on the first row. Reading last_line lays the rows out now.
        _ = tree.last_line
        if target is None:
            # The first shown bead, so the detail opens on a bead rather than an area.
            target = next((n for n in self.walk(tree.root) if n.data and n.data[0] == "bead"
                           and all(p.is_expanded for p in self.ancestors(n))), None)
        if target is not None and all(p.is_expanded for p in self.ancestors(target)):
            tree.move_cursor(target)
        self.show_detail()

    @staticmethod
    def walk(node: TreeNode):
        for child in node.children:
            yield child
            yield from BeadBoard.walk(child)

    @staticmethod
    def ancestors(node: TreeNode):
        p = node.parent
        while p is not None and not p.is_root:
            yield p
            p = p.parent

    def on_tree_node_expanded(self, event: Tree.NodeExpanded) -> None:
        self.track(event.node, True)

    def on_tree_node_collapsed(self, event: Tree.NodeCollapsed) -> None:
        self.track(event.node, False)

    def track(self, node: TreeNode, expanded: bool) -> None:
        if getattr(self, "rebuilding", False) or self.query_text or not node.data or self.expanded is None:
            return
        key = f"a:{node.data[1]}" if node.data[0] == "area" else f"e:{node.data[2]}/{node.data[1]}"
        (self.expanded.add if expanded else self.expanded.discard)(key)

    def on_tree_node_highlighted(self, event: Tree.NodeHighlighted) -> None:
        self.show_detail()

    # ---------- detail ----------

    def selected(self) -> tuple | None:
        node = self.query_one(BeadTree).cursor_node
        return node.data if node is not None else None

    def show_detail(self) -> None:
        data = self.selected()
        if not data:
            self.detail = self.empty_text()
        elif self.thread_view and data[0] != "area":
            self.detail = self.thread_text(data[1] if data[0] == "epic" else bm.epic_of(self.beads, data[1]))
        elif data[0] == "bead":
            self.detail = self.bead_text(data[1])
        elif data[0] == "epic":
            self.detail = self.epic_text(data[1]) if data[1] else Text("Beads without an epic.", style=MUTED)
        else:
            self.detail = self.area_text(data[1])
        self.query_one("#body", Static).update(self.detail)
        # A rebuild that reselects the same row keeps the reading position; a new row starts at the top.
        if (data, self.thread_view) != self.detail_for:
            self.detail_for = (data, self.thread_view)
            self.query_one("#detail").scroll_home(animate=False)

    def empty_text(self) -> Text:
        """What the detail pane says when the list is empty: which other lists the same filters find beads in."""
        elsewhere = [f"{SCOPES[s][0]} shows {n} {s}" for s in SCOPES if s != self.scope_name
                     for n in [len(self.funnel(s)[-1][1])] if n]
        if elsewhere:
            return Text(f"Nothing in this list. {', '.join(elsewhere)}.", style=MUTED)
        narrowed = any(self.filters_on.values()) or self.query_text
        return Text("Nothing in this list." + (" A highlighted key removes its filter." if narrowed else ""), style=MUTED)

    def status_line(self, bid: str, words: list[tuple[str, str]]) -> Text:
        return joined([(bid, ID), *words, (f"P{self.beads[bid].get('priority', '')}", MUTED)])

    def bead_text(self, bid: str) -> Group:
        """The approved order: why it is listed, If skipped, labels, Done when, thread, latest note, follow-ups."""
        b, epic = self.beads[bid], bm.epic_of(self.beads, bid)
        until = local_date(b.get("defer_until")) if b["bucket"] == "deferred" else ""
        why = [(STATUS_WORD[b["bucket"]] + (f" until {until}" if until else ""), STATUS_STYLE[b["bucket"]])]
        why += [("needs you", NEEDS_STYLE)] if b["needsYou"] else []
        why += [("to review", REVIEW_STYLE)] if b["awaiting"] else []
        if self.sessions.get(bid):
            why.append((f"session {self.sessions[bid]}", SESSION_STYLE.get(self.sessions[bid], "")))
        parts: list[RenderableType] = [self.status_line(bid, why), Text(b.get("title") or "", style="bold")]
        if b["needsYou"]:
            asks = grid()
            for a in b["asks"] or [{"text": "Decision bead, waiting on you" if b["kind"]["name"] == "decision"
                                    else "Marked needs:ben with no question in its notes"}]:
                asks.add_row(Text("?", style=NEEDS_STYLE),
                             Text(a["text"]) + (Text(" (guessed from prose)", style=MUTED) if a.get("prose") else Text("")))
            parts.append(asks)
        parts += [Text(""), Text("If skipped", style=HEAD)]
        s = b["ifSkipped"]
        if s:
            lines = grid()
            for key, name in (("date", "date"), ("result", "result"), ("worst", "worst"), ("why", "priority")):
                value = s.get(key, "–")
                head, sep, rest = value.partition(": ")
                if value == "unchanged":
                    shown = Text(value, style=MUTED)
                elif sep and head in ("slips", "changes"):
                    shown = Text.assemble((head + ":", WARM), " " + rest)
                else:
                    shown = Text(value)
                lines.add_row(Text(f" {name}", style=MUTED), shown)
            parts.append(lines)
        else:
            parts.append(Text(" no ## If skipped section", style=MUTED))
        parts += [Text(""), self.labels_line(b), Text(""), self.done_when(b["checks"], "Done when")]
        blockers = [x for x in b["blockers"] if self.beads[x]["status"] != "closed"]
        blocks = [x for x in b["blocks"] if self.beads[x]["status"] != "closed"]
        thread = Text.assemble(("Thread ", HEAD), (epic or "–", ID if epic else MUTED))
        for word, xs in (("blocked by", blockers), ("blocks", blocks)):
            thread.append(f" · {word} ", style=MUTED)
            thread.append(" ".join(short(x, epic) for x in xs) or "–", style=ID if xs else MUTED)
        parts += [Text(""), thread]
        parts.append(Text(""))
        if b["status"] == "closed":
            parts += [Text("Result", style=HEAD), markdown_lite(b.get("close_reason") or "Closed without a reason.")]
        else:
            note = b["current"]
            head = Text.assemble(("Latest ", HEAD), (note["date"] if note else "no dated note yet", MUTED))
            parts += [head] + ([markdown_lite(note_body(note))] if note else [])
        if b["followups"]:
            unfiled = f"  {b['unfiled']} unfiled" if b["unfiled"] else ""
            rows = grid()
            for f in b["followups"]:
                mark = (Text(" ".join(short(i, epic) for i in f["ids"]), style=ID) if f["ids"]
                        else Text("⚑ unfiled", style=WARM))
                rows.add_row(mark, Text(f["text"]))
            parts += [Text(""), Text.assemble(("Follow-ups", HEAD), (unfiled, WARM)), rows]
        if b["flags"]:
            parts.append(Text(f"⚠ {' · '.join(b['flags'])}", style="#f9e2af"))
        return Group(*parts)

    def done_when(self, checks: dict, heading: str) -> Group:
        head = Text.assemble((heading, HEAD), (f"  {checks['ticked']}/{checks['n']}" if checks["marked"] else "", MUTED))
        if not checks["items"]:
            return Group(head, Text(" none", style=MUTED))
        rows = grid()
        for item in checks["items"]:
            if item.get("head"):
                rows.add_row(Text(""), Text(item["text"], style=MUTED))
            elif item["done"]:
                rows.add_row(Text(" ☑", style="#a6e3a1"), Text(item["text"], style=MUTED))
            else:
                rows.add_row(Text(" ☐", style=MUTED), Text(item["text"]))
        return Group(head, rows)

    @staticmethod
    def labels_line(b: dict) -> Text:
        if b.get("issue_type") == "epic":
            return Text("epic", style=MUTED)
        run = [f"ben:{b['ben']}" if b["ben"] else "no ben: label"]
        run += [f"wait:{b['wait']}"] if b["wait"] else []
        run += [f"mode:{b['mode']}"] if b["mode"] else []
        kind = f"kind:{b['kind']['name']}" + ("?" if b["kind"]["inferred"] else "")
        words = [(w, MUTED) for w in run + [kind]]
        return joined(words + ([("one-shot", "#89b4fa")] if b["oneshot"] else []))

    def epic_text(self, epic: str) -> Group:
        e, kids = self.beads[epic], bm.descendants(self.beads, epic)
        n = {k: sum(1 for i in kids if self.beads[i]["bucket"] == k) for k in bm.RANK}
        you = sum(1 for i in kids if self.needs_you(i))
        parts: list[RenderableType] = [
            self.status_line(epic, [("epic", MUTED), (STATUS_WORD[e["bucket"]], STATUS_STYLE[e["bucket"]])]),
            Text(e.get("title") or "", style="bold"),
            joined([(f"{n['closed']}/{len(kids)} closed", MUTED), (f"{n['prog']} working", STATUS_STYLE["prog"]),
                    (f"{you} need you", NEEDS_STYLE if you else MUTED), (f"{n['ready']} ready", MUTED),
                    (f"{n['blocked']} blocked", WARM if n["blocked"] else MUTED)]),
            Text(""), self.done_when(e["checks"], "Goal"), Text("")]
        p0 = self.p0_beads(epic)
        left = [i for i in bm.thread_order(self.beads, epic) if i in p0]
        head = Text("Open P0 beads", style=HEAD)
        if not p0:
            parts += [head, Text(" none, because the epic has no P0 bead", style=MUTED)]
        elif not left:
            parts += [head, Text(f" none, because all {len(p0)} P0 beads are closed", style=MUTED)]
        else:
            parts += [head + Text(f"  {len(left)} of {len(p0)}", style=MUTED), self.order_rows(epic, left)]
        parts.append(Text(""))
        note = e["current"]
        parts.append(Text.assemble(("Latest ", HEAD), (note["date"] if note else "no dated note yet", MUTED)))
        if note:
            parts.append(markdown_lite(note_body(note)))
        parts.append(Text("g shows the thread's open beads in dependency order", style=MUTED))
        return Group(*parts)

    def area_text(self, area: str) -> Text:
        ids = [i for i in self.shown() if (bm.area_of(self.beads, i) or NO_AREA) == area]
        return self.area_label(area, ids) + Text(f"\n{len(ids)} beads listed", style=MUTED)

    def thread_text(self, epic: str | None) -> RenderableType:
        if epic is None:
            return Text("This bead has no epic, so it has no thread.", style=MUTED)
        head = Text.assemble(("Thread ", HEAD), (epic, ID), " " + (self.beads[epic].get("title") or ""))
        rows = self.order_rows(epic, bm.thread_order(self.beads, epic))
        return Group(head, Text("Open beads in dependency order; g returns to the bead", style=MUTED), Text(""), rows)

    def order_rows(self, epic: str, ids: list[str]) -> Table:
        """One row per bead: its status mark, its short id, its title, and the open beads it waits on."""
        rows = grid()
        for bid in ids:
            b = self.beads[bid]
            waits = [short(x, epic) for x in b["blockers"] if self.beads[x]["status"] != "closed"]
            mark = Text.assemble((STATUS_MARK[b["bucket"]], STATUS_STYLE[b["bucket"]]), ("?" if b["needsYou"] else " ", NEEDS_STYLE))
            title = Text(b.get("title") or "") + (Text(f"  waits on {' '.join(waits)}", style=MUTED) if waits else Text(""))
            rows.add_row(mark, Text(short(bid, epic), style=ID), title)
        return rows

    # ---------- chrome ----------

    def render_title(self) -> None:
        """The list's steps with the beads left after each, such as Open 127 › now 42, then the board-wide counts.

        The need-you count spans every list, so a closed result that asks Ben a question counts from any view.
        """
        beads = [b for b in self.beads.values() if b.get("issue_type") != "epic"]
        working = sum(1 for b in beads if b["status"] == "in_progress")
        you = sum(1 for b in beads if bm.asks_ben_now(b))
        steps = Text(" › ", style=MUTED).join(Text(f"{name} {len(ids)}") for name, ids in self.funnel())
        parts = [(f"{working} working", STATUS_STYLE["prog"]), (f"{you} need you", NEEDS_STYLE)]
        if self.read_at:
            parts.append((f"read {time.strftime('%H:%M', time.localtime(self.read_at))}", MUTED))
        if self.error:
            parts.append((self.error.splitlines()[0], "bold #f38ba8"))
        self.title_text = Text.assemble(("bd-tui", "bold"), (" · ", MUTED), steps, (" · ", MUTED), joined(parts))
        self.query_one("#title", Static).update(self.title_text)

    def render_keys(self) -> None:
        """The key strip: the lists and the filters on the first row, the other keys below, wrapped to the pane.

        A list or filter key shows how many beads the tree would list after pressing it, and a key that is on
        shows in reverse. v appears only on the closed list, the one list it narrows.
        """
        scopes = [(key, f"{s} {len(self.funnel(s)[-1][1])}", s == self.scope_name) for s, (key, _, _) in SCOPES.items()]
        filters = []
        for name, key, _ in FILTERS:
            if name == "unreviewed" and self.scope_name != "closed":
                continue
            on = self.filters_on[name]
            left = len(self.funnel(filters={**self.filters_on, name: True})[-1][1])
            filters.append((key, name if on else f"{name} {left}", on))
        filters.append(("/", "search", bool(self.query_text)))
        others = [(key, what, what == "thread" and self.thread_view) for key, what in KEYS]
        width = max(20, (self.size.width or 80) - 2)
        lines = wrap_keys([scopes, filters], width) + wrap_keys([others], width)
        self.keys_text = Text("\n").join(lines)
        keys = self.query_one("#keys", Static)
        keys.update(self.keys_text)
        keys.styles.height = len(lines)

    # ---------- actions ----------

    def action_scope(self, scope: str) -> None:
        """o, d or c: show the open, deferred or closed list, keeping every filter that applies to it."""
        self.scope_name = scope
        if scope != "closed":
            self.filters_on["unreviewed"] = False
        self.open_busiest = True
        self.rebuild()

    def action_narrow(self, name: str) -> None:
        """n, v or p: narrow the list by one filter, or remove the filter when it is on."""
        if name == "unreviewed" and self.scope_name != "closed":
            self.notify("v narrows the closed list to unreviewed results. c shows the closed list.")
            return
        self.filters_on[name] = not self.filters_on[name]
        self.rebuild()

    def action_thread(self) -> None:
        self.thread_view = not self.thread_view
        self.render_keys()
        self.show_detail()

    def action_search(self) -> None:
        box = self.query_one("#search", LineInput)
        box.add_class("on")
        box.focus()

    def on_input_changed(self, event: Input.Changed) -> None:
        if event.input.id == "search":
            self.query_text = event.value.strip()
            self.rebuild()

    def on_input_submitted(self, event: Input.Submitted) -> None:
        if event.input.id == "search":
            self.query_one(BeadTree).focus()

    def action_clear_search(self) -> None:
        box = self.query_one("#search", LineInput)
        if not box.has_class("on"):
            return
        box.value = ""
        box.remove_class("on")
        self.query_text = ""
        self.query_one(BeadTree).focus()
        self.rebuild()

    def selected_id(self) -> str | None:
        data = self.selected()
        return data[1] if data and data[0] in ("bead", "epic") and data[1] else None

    def action_open_bead(self) -> None:
        """Enter: the full `bd show` text, read-only in nvim; on an area, fold it."""
        data = self.selected()
        if data and data[0] == "area":
            self.query_one(BeadTree).action_toggle_node()
            return
        bid = self.selected_id()
        if not bid:
            return
        try:
            text = subprocess.run(["bd", "show", bid], capture_output=True, text=True, check=True,
                                  env={**os.environ, "NO_COLOR": "1"}).stdout
        except (subprocess.CalledProcessError, OSError) as e:
            self.notify(f"bd show failed: {getattr(e, 'stderr', '') or e}", severity="error")
            return
        path = os.path.join(tempfile.gettempdir(), f"bd-tui-{bid}.md")
        with open(path, "w") as f:
            f.write(text)
        with self.suspend():
            subprocess.run(["nvim", "-R", "-c", "setlocal filetype=markdown nomodifiable", path])

    def action_mark_reviewed(self) -> None:
        """m: mark the selected closed bead's result reviewed, or undo that when it is already reviewed."""
        data = self.selected()
        if not data or data[0] != "bead":
            return
        b = self.beads[data[1]]
        if b["status"] != "closed":
            self.notify(f"{b['id']} is open. m marks a closed result reviewed.")
            return
        self.mark(b["id"], b["awaiting"])

    @work(thread=True, group="review")
    def mark(self, bid: str, reviewed: bool) -> None:
        try:
            self.set_reviewed(bid, reviewed)
        except (ValueError, subprocess.CalledProcessError, OSError) as e:
            msg = (getattr(e, "stderr", "") or str(e)).strip()
            self.call_from_thread(self.notify, f"bd label failed: {msg}", severity="error")
            return
        done = f"{bid} marked reviewed · m again undoes" if reviewed else f"{bid} is a result to review again"
        self.call_from_thread(self.notify, done)
        self.call_from_thread(self.action_reload)

    def action_status(self) -> None:
        """Shift-S on a bead row: the status menu, then the prompt that the chosen status needs.

        The bead id and its status are fixed here, because a reread can rebuild the tree while the menu is open.
        """
        data = self.selected()
        if not data or data[0] != "bead":
            self.notify("S changes a bead's status. Move the cursor to a bead.")
            return
        b = self.beads[data[1]]
        bid, current, title = b["id"], b["status"], b.get("title") or ""
        open_kids = sum(1 for i in bm.descendants(self.beads, bid) if self.beads[i]["status"] != "closed")

        def filled(target: str, values: dict | None) -> None:
            if values is not None:
                self.move(bid, current, target, values)

        def chosen(target: str | None) -> None:
            if target in FORMS:
                self.push_screen(ActScreen(target, bid, title, self.drafts.get((target, bid), {})),
                                 lambda values: filled(target, values))
            elif target:
                self.move(bid, current, target, {})

        self.push_screen(StatusScreen(bid, title, current, open_kids), chosen)

    @work(thread=True, group="status")
    def move(self, bid: str, current: str, target: str, values: dict) -> None:
        try:
            bm.set_status(bid, current, target, values, self.run_bd)
        except (ValueError, subprocess.SubprocessError, OSError) as e:
            msg = (getattr(e, "stderr", "") or str(e)).strip()
            self.call_from_thread(self.move_failed, bid, target, values, msg)
            return
        self.call_from_thread(self.move_done, bid, target)

    def move_failed(self, bid: str, target: str, values: dict, msg: str) -> None:
        """Keep what Ben typed, so that picking the same status for the same bead opens the prompt with it."""
        if values:
            self.drafts[(target, bid)] = values
        again = "\nS and the same status bring back what you typed." if values else ""
        self.notify(f"bd could not move {bid} to {MENU[target][1]}: {msg}{again}", severity="error", timeout=15)
        self.action_reload()

    def move_done(self, bid: str, target: str) -> None:
        self.drafts.pop((target, bid), None)
        self.notify(f"{bid} is {MENU[target][1]}" + (" and its result counts as reviewed" if target == "closed" else ""))
        self.action_reload()

    def action_start_session(self) -> None:
        bid = self.selected_id()
        if not bid:
            return
        keywords = [self.beads[bid]["mode"]] if self.beads[bid]["mode"] in bm.SESSION_KEYWORDS else []

        def launch(ask: str | None) -> None:
            if ask and ask.strip():
                self.launch(bid, ask, keywords)

        self.push_screen(AskScreen(bid, keywords), launch)

    @work(thread=True, group="launch")
    def launch(self, bid: str, ask: str, keywords: list[str]) -> None:
        try:
            out = bm.launch_session(bid, ask, keywords)
        except (ValueError, RuntimeError, subprocess.SubprocessError, OSError) as e:
            msg = (getattr(e, "stderr", "") or str(e)).strip()
            self.call_from_thread(self.notify, f"Starting the session failed: {msg}", severity="error", timeout=15)
            return
        self.call_from_thread(self.notify, f"Started {out['session']} · {out['name']}\na attaches to it", timeout=10)
        self.call_from_thread(self.refresh_sessions)

    @work(thread=True, group="attach")
    def action_attach(self) -> None:
        bid = self.call_from_thread(self.selected_id)
        if not bid:
            return
        try:
            sessions = bm.bead_sessions(bid)
        except (subprocess.SubprocessError, OSError, ValueError) as e:
            self.call_from_thread(self.notify, f"claude agents failed: {e}", severity="error")
            return
        if not sessions:
            self.call_from_thread(self.notify, f"No session is named after {bid}. s starts one.")
            return
        sid = sessions[0]["id"]
        if not os.environ.get("TMUX"):
            self.call_from_thread(self.notify, f"Not inside tmux. Run: claude attach {sid}", timeout=15)
            return
        try:
            subprocess.run(["tmux", "new-window", "-n", bid, "-c", bm.SESSION_CWD, "claude", "attach", sid],
                           capture_output=True, text=True, check=True)
        except (subprocess.CalledProcessError, OSError) as e:
            self.call_from_thread(self.notify, f"tmux new-window failed: {getattr(e, 'stderr', '') or e}", severity="error")


def open_window(refresh_s: float) -> None:
    """Open a tmux window with claude agents on the left and bd-tui on the right."""
    if not os.environ.get("TMUX"):
        sys.exit("bd-tui --window runs inside tmux. Start tmux, or run bd-tui on its own.")
    env = ["-e", f"BEADS_DIR={os.environ['BEADS_DIR']}"] if os.environ.get("BEADS_DIR") else []
    window = subprocess.run(["tmux", "new-window", "-P", "-F", "#{window_id}", "-n", "beads", "-c", bm.SESSION_CWD,
                             "claude", "agents"], capture_output=True, text=True, check=True).stdout.strip()
    subprocess.run(["tmux", "split-window", "-h", "-t", window, "-l", TMUX_SPLIT, "-c", bm.SESSION_CWD, *env,
                    os.path.realpath(__file__), "--refresh", f"{refresh_s:g}"], check=True)


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--window", action="store_true", help="inside tmux, open claude agents and bd-tui side by side")
    ap.add_argument("--export", metavar="FILE", help="read a saved `bd export` (JSON lines) instead of running bd")
    ap.add_argument("--refresh", metavar="SECONDS", type=float, default=REFRESH_S,
                    help=f"reread the beads this often (default {REFRESH_S}); 0 rereads only on r")
    args = ap.parse_args()
    if args.refresh < 0:
        ap.error("--refresh takes 0 or more seconds")
    bm.default_beads_dir()
    if args.window:
        open_window(args.refresh)
        return
    if args.export:
        def load() -> list[dict]:
            with open(args.export) as f:
                return [json.loads(line) for line in f if line.strip()]
        BeadBoard(load_rows=load, refresh_s=args.refresh).run()
    else:
        BeadBoard(refresh_s=args.refresh).run()


if __name__ == "__main__":
    main()
